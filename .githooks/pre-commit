#!/bin/sh
# Blocks commits containing secrets. This repo is public, so a leak here is a
# rotation exercise rather than a revert.
#
# Enable once per clone: git config core.hooksPath .githooks
set -eu

# gitleaks won't spot a made-up password in a plain Secret, so check that
# staged kubernetes/ YAML is encrypted first.
if command -v sops >/dev/null 2>&1; then
  git diff --cached --name-only --diff-filter=ACMR -z -- 'kubernetes/*.yaml' \
    | xargs -0 kubernetes/check-encryption.sh --staged
else
  git diff --cached --name-only --diff-filter=ACMR -z -- 'kubernetes/*.yaml' \
    | xargs -0 nix shell --inputs-from . nixpkgs#sops --command \
        kubernetes/check-encryption.sh --staged
fi

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --staged --no-banner --redact
fi

# Fall back to nix, for commits made outside the dev shell. --inputs-from
# pins gitleaks to flake.lock; a bare nixpkgs# would track unstable.
if command -v nix >/dev/null 2>&1; then
  exec nix run --inputs-from . nixpkgs#gitleaks -- \
    git --staged --no-banner --redact
fi

echo "pre-commit: gitleaks not found, and no nix to fetch it" >&2
exit 1
