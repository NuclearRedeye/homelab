#!/bin/sh
# Blocks commits containing secrets. This repo is public, so a leak here is a
# rotation exercise rather than a revert.
#
# Enable once per clone: git config core.hooksPath .githooks
set -eu

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --staged --no-banner --redact
fi

# Fall back to nix, for commits made outside the dev shell. --inputs-from
# pins gitleaks to flake.lock; a bare nixpkgs# would track unstable.
if command -v nix >/dev/null 2>&1; then
  exec nix run --inputs-from . nixpkgs#gitleaks -- \
    git --staged --no-banner --redact
fi

echo "pre-commit: gitleaks not found, and no nix to fetch it" >&2
exit 1
